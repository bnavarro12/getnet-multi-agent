# Copy this file to .env and fill in your key: cp .env.example .env
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Staff key for the dashboard, the human-agent inbox (/agent) and /metrics, /analytics, /evals, /handoffs.
# Pick a long random value, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_API_KEY=

# Optional overrides (defaults shown). "-latest" aliases always point to the current Gemini release;
# pin an exact model id here if you prefer reproducibility.
# LLM_MODEL=gemini-flash-lite-latest
# Reasoning effort: minimal | low | medium | high (empty = model default)
# LLM_THINKING_LEVEL=low
# LLM_TIMEOUT_S=120
# ROUTER_MODEL=gemini-flash-lite-latest
# EMBEDDING_MODEL=gemini-embedding-001
# MAX_TOOL_ITERATIONS=5
# ROUTER_CONFIDENCE_THRESHOLD=0.55
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.45
# CRAWL_MAX_PAGES=60
# AUTO_INGEST=true
# LOG_LEVEL=INFO
# JUDGE_MODEL=gemini-flash-latest        # eval judge: a different model from the agents
# AUTH_ENABLED=true                       # false = trust user_id from the body (original challenge contract)
# RATE_LIMIT_PER_MINUTE=20
# MEMORY_MAX_TURNS=6
# SESSION_TTL_HOURS=24
# RETRIEVAL_MODE=dense                    # dense | hybrid (dense + BM25 + RRF)
# INDEX_MAX_AGE_DAYS=7                    # older index is refreshed in the background (0 = never)
# MAX_PLAN_STEPS=2
